# Copy this file to .env. The app can also fill these in for you from the web page.

# GitHub token used for searching (no permissions needed).
# Create one at https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# Gmail account used by the "Send emails" feature.
# GMAIL_APP_PASSWORD is a 16-character App Password, NOT your normal password:
#   https://myaccount.google.com/apppasswords  (turn on 2-Step Verification first)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_SENDER_NAME=
